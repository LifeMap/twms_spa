---
import type { Lang } from '../i18n';
interface Props { lang: Lang; service?: 'jarvis' | 'orch-ai' | 'twms-studio' }
const { lang, service = 'jarvis' } = Astro.props;
const name = { jarvis: 'Jarvis', 'orch-ai': 'Orch AI', 'twms-studio': 'TWMS Studio' }[service];
const dialogId = `preview-${service}`;
const baseText = {
 ko: { title: 'Jarvis 화면 미리보기', status: '개발 중 화면', note: '실제 개발 화면입니다. 정식 공개 시 구성과 기능이 달라질 수 있습니다.', close: '미리보기 닫기', previous: '이전 화면', next: '다음 화면', full: '원본 이미지 보기 ↗', titles: ['대화와 음성 인터페이스', '관리자 대시보드'], descriptions: ['자연어로 대화하고 음성 입력·응답 듣기를 사용할 수 있는 Playground 화면.', '에이전트 요청과 도구 실행, 승인 및 스케줄 상태를 살펴보는 관리 화면.'] },
 en: { title: 'Jarvis preview', status: 'In development', note: 'Actual development screenshots. Layout and features may change before release.', close: 'Close preview', previous: 'Previous screen', next: 'Next screen', full: 'View original image ↗', titles: ['Conversation and voice interface', 'Admin dashboard'], descriptions: ['The Playground interface for natural-language conversations, voice input and spoken responses.', 'An overview of agent requests, tool runs, approvals and schedules.'] },
 ja: { title: 'Jarvis 画面プレビュー', status: '開発中の画面', note: '実際の開発画面です。正式公開時に構成や機能が変わる場合があります。', close: 'プレビューを閉じる', previous: '前の画面', next: '次の画面', full: '元の画像を開く ↗', titles: ['会話と音声インターフェース', '管理ダッシュボード'], descriptions: ['自然言語での会話、音声入力・読み上げのためのPlayground画面。', 'エージェントへの依頼、ツール実行、承認やスケジュールを確認する管理画面。'] },
}[lang];
const orchText = {
 ko: { title: 'Orch AI 화면 미리보기', status: '디자인 프리뷰 · 예시 데이터', note: '예시 데이터를 사용한 디자인 프리뷰입니다. 실제 작업 실행이나 검증 결과를 나타내지 않으며, 정식 공개 시 구성이 달라질 수 있습니다.', titles: ['태스크 보드와 프로젝트 대시보드'], descriptions: ['프로젝트의 태스크와 하위 작업을 단계별로 살펴보는 보드 화면. 준비·실행·검토·완료 등의 흐름을 예시 데이터로 보여줍니다.'] },
 en: { title: 'Orch AI preview', status: 'Design preview · Sample data', note: 'A design preview using sample data, not evidence of actual task execution or verification. Layout may change before release.', titles: ['Task board and project dashboard'], descriptions: ['A board view of project tasks and subtasks. Sample data illustrates stages such as ready, running, review and done.'] },
 ja: { title: 'Orch AI 画面プレビュー', status: 'デザインプレビュー・サンプルデータ', note: 'サンプルデータを使用したデザインプレビューです。実際のタスク実行や検証結果ではなく、正式公開時に構成が変わる場合があります。', titles: ['タスクボードとプロジェクトダッシュボード'], descriptions: ['プロジェクトのタスクとサブタスクを段階ごとに確認するボード画面。準備・実行・レビュー・完了などの流れをサンプルデータで示しています。'] },
}[lang];
const studioText = {
 ko: { title: 'TWMS Studio 화면 미리보기', status: '디자인 목업 · 샘플 프로젝트', note: '샘플 프로젝트를 사용한 디자인 목업입니다. 화면의 진행 상태는 실제 실행 이력이 아니며, 정식 공개 시 구성과 기능이 달라질 수 있습니다.', titles: ['프로젝트와 제작 흐름 대시보드'], descriptions: ['프로젝트와 씬별 상태, 원본 분석부터 영상 생성·품질 확인·러프컷까지의 제작 흐름을 보여주는 콘셉트 화면.'] },
 en: { title: 'TWMS Studio preview', status: 'Design mockup · Sample project', note: 'A design mockup using a sample project. Progress shown is not actual execution history. Layout and features may change before release.', titles: ['Project and production dashboard'], descriptions: ['A concept screen showing projects, scene status and a production workflow from source analysis to video generation, quality checks and rough cuts.'] },
 ja: { title: 'TWMS Studio 画面プレビュー', status: 'デザインモックアップ・サンプルプロジェクト', note: 'サンプルプロジェクトを使用したデザインモックアップです。表示された進捗は実際の実行履歴ではなく、正式公開時に構成や機能が変わる場合があります。', titles: ['プロジェクトと制作フローのダッシュボード'], descriptions: ['プロジェクトやシーンの状態、原本分析から動画生成・品質確認・ラフカットまでの制作フローを示すコンセプト画面。'] },
}[lang];
const text = { ...baseText, ...({ jarvis: baseText, 'orch-ai': orchText, 'twms-studio': studioText }[service]) };
const images = service === 'twms-studio' ? [
 { src: '/previews/twms-studio/dashboard.png', width: 4566, height: 2800 },
] : service === 'orch-ai' ? [
 { src: '/previews/orch-ai/dashboard.png', width: 5344, height: 2916 },
] : [
 { src: '/previews/jarvis/playground.png', width: 2848, height: 2322 },
 { src: '/previews/jarvis/dashboard.png', width: 4242, height: 2406 },
];
---
<dialog id={dialogId} class="service-preview" aria-labelledby={`${dialogId}-title`} aria-describedby={`${dialogId}-note`}>
 <div class="preview-header">
  <div><span class="preview-status">{text.status}</span><h2 id={`${dialogId}-title`}>{text.title}</h2></div>
  <button type="button" class="preview-close" data-preview-close aria-label={text.close} autofocus>×</button>
 </div>
 <p class="preview-note" id={`${dialogId}-note`}>{text.note}</p>
 <div class="preview-tabs" role="tablist" aria-label={text.title}>
  {images.map((_, index) => <button type="button" role="tab" id={`${service}-tab-${index}`} aria-controls={`${service}-screen-${index}`} aria-selected={String(index === 0)} tabindex={index === 0 ? 0 : -1} data-preview-tab={index}><span>0{index + 1}</span>{text.titles[index]}</button>)}
 </div>
 {images.map((image, index) => <section role="tabpanel" id={`${service}-screen-${index}`} aria-labelledby={`${service}-tab-${index}`} hidden={index !== 0} tabindex="0" data-preview-panel>
  <div class="preview-image"><img src={image.src} width={image.width} height={image.height} alt={`${name} — ${text.titles[index]}`} loading="lazy" decoding="async" /></div>
  <div class="preview-caption"><p>{text.descriptions[index]}</p><a href={image.src} target="_blank" rel="noopener noreferrer">{text.full}</a></div>
 </section>)}
 <div class="preview-footer"><span data-preview-count aria-live="polite" aria-atomic="true">01 / {String(images.length).padStart(2, '0')}</span>{images.length > 1 && <div><button type="button" data-preview-step="-1" aria-label={text.previous}>←</button><button type="button" data-preview-step="1" aria-label={text.next}>→</button></div>}</div>
</dialog>

<script>
 document.querySelectorAll<HTMLDialogElement>('.service-preview').forEach(dialog => {
  const tabs = [...dialog.querySelectorAll<HTMLButtonElement>('[data-preview-tab]')];
  const panels = [...dialog.querySelectorAll<HTMLElement>('[data-preview-panel]')];
  let current = 0, opener: HTMLButtonElement | null = null;
  const select = (index: number, focus = false) => {
   current = (index + tabs.length) % tabs.length;
   tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === current)); tab.tabIndex = i === current ? 0 : -1; panels[i].hidden = i !== current; });
   dialog.querySelector<HTMLElement>('[data-preview-count]')!.textContent = `${String(current + 1).padStart(2, '0')} / ${String(tabs.length).padStart(2, '0')}`;
   if (focus) tabs[current].focus();
  };
  document.querySelectorAll<HTMLButtonElement>(`[data-open-preview="${dialog.id}"]`).forEach(button => button.addEventListener('click', () => {
   if (dialog.open) return;
   opener = button; select(0); dialog.showModal(); document.body.classList.add('dialog-open');
  }));
  tabs.forEach((tab, i) => {
   tab.addEventListener('click', () => select(i));
   tab.addEventListener('keydown', event => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault(); select(event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : current + (event.key === 'ArrowRight' ? 1 : -1), true);
   });
  });
  dialog.querySelectorAll<HTMLButtonElement>('[data-preview-step]').forEach(button => button.addEventListener('click', () => select(current + Number(button.dataset.previewStep))));
  dialog.querySelector('[data-preview-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => {
   if (event.target !== dialog) return;
   const rect = dialog.getBoundingClientRect();
   if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
  });
  dialog.addEventListener('close', () => {
   if (!document.querySelector('dialog[open]')) document.body.classList.remove('dialog-open');
   opener?.focus({ preventScroll: true });
  });
 });
</script>

<style>
 .service-preview { width:min(1200px,calc(100vw - 40px)); max-height:calc(100dvh - 40px); margin:auto; padding:28px; border:1px solid #2b4d3433; border-radius:24px; background:#faf9f2; color:#102b1b; box-shadow:0 30px 100px #0004; overflow-y:auto; overscroll-behavior:contain; }
 .service-preview::backdrop { background:#061c13bb; backdrop-filter:blur(8px); }
 .preview-header { display:flex; align-items:center; justify-content:space-between; gap:20px; }
 .preview-status { display:inline-block; font-size:10px; letter-spacing:.05em; padding:6px 10px; border-radius:20px; background:#e5e0f3; color:#563888; }
 .preview-header h2 { margin:12px 0 0; font-size:clamp(23px,3vw,34px); letter-spacing:-.05em; font-weight:600; }
 .preview-close,.preview-footer button { display:grid; place-items:center; width:44px; height:44px; padding:0; border:1px solid #102b1b30; border-radius:50%; background:transparent; color:inherit; cursor:pointer; }
 .preview-close { font-size:28px; flex-shrink:0; }
 .preview-note { margin:12px 0 24px; font-size:12px; line-height:1.7; color:#65705c; }
 .preview-tabs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
 .preview-tabs button { border:1px solid #102b1b26; background:transparent; color:#52624f; border-radius:30px; padding:12px 16px; font:inherit; font-size:12px; cursor:pointer; }
 .preview-tabs button span { font:10px ui-monospace,monospace; margin-right:10px; opacity:.6; }
 .preview-tabs button[aria-selected="true"] { background:#102b1b; color:#edf2e9; border-color:#102b1b; }
 .preview-image { display:flex; align-items:center; justify-content:center; background:#08130f; border:1px solid #102b1b26; border-radius:14px; overflow:hidden; }
 .preview-image img { display:block; width:100%; height:auto; max-height:62dvh; object-fit:contain; }
 .preview-caption { display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-top:14px; font-size:12px; line-height:1.8; }
 .preview-caption p { margin:0; color:#52624f; }.preview-caption a { text-decoration:underline; text-underline-offset:4px; white-space:nowrap; }
 .preview-footer { display:flex; align-items:center; justify-content:space-between; margin-top:20px; padding-top:16px; border-top:1px solid #102b1b20; }
 .preview-footer > span { font:11px ui-monospace,monospace; color:#65705c; }.preview-footer > div { display:flex; gap:8px; }
 button:hover { background:#d3e7c8; color:#102b1b; }button:focus-visible,a:focus-visible,[role="tabpanel"]:focus-visible { outline:2px solid #426b39; outline-offset:4px; }
 @media(max-width:600px) { .service-preview { width:calc(100vw - 20px); max-height:calc(100dvh - 20px); padding:20px 16px; border-radius:18px; }.preview-tabs { gap:6px; }.preview-tabs button { padding:12px; font-size:11px; }.preview-tabs button span { margin-right:6px; }.preview-image { border-radius:8px; }.preview-caption { font-size:11px; } }
</style>
