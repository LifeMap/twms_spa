---
import type { Lang } from '../i18n';
import ContactForm from './ContactForm.astro';
import ServicePreview from './ServicePreview.astro';
import { useTranslations, languages, getLocalizedPath } from '../i18n';
import { withHomepageUtm } from '../utils/campaign-url.js';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = {
 ko: { intro: '작은 시작에서, 더 큰 가능성으로.', body: 'AI와 함께 만들고, 반복을 자동화합니다. 작은 아이디어를 실제로 작동하는 서비스로 바꾸는 일. TWMS가 만들어가는 모멘텀입니다.', explore: '우리가 만드는 것들', scroll: '아래에서 더 만나보세요', approach: '작은 승리를 만드는 방식', products: '아이디어를 일상으로.', productBody: '반복하는 일은 줄이고, 중요한 일에 집중할 수 있도록.', next: '다음 작은 승리', contact: '다음 아이디어를 함께.', contactBody: '작은 질문도, 새로운 가능성도 환영합니다.', sound: '소리 켜기', mute: '소리 끄기', pause: '일시 정지', play: '재생', film: 'TWMS 브랜드 필름', skip: '본문으로 건너뛰기' },
 en: { intro: 'Small beginnings. Bigger possibilities.', body: 'We build with AI and automate the repetitive. Turning small ideas into products that work. This is the momentum we’re creating at TWMS.', explore: 'Explore our work', scroll: 'There’s more below', approach: 'How we make small wins', products: 'Ideas, made everyday.', productBody: 'Less repetitive work. More room for what matters.', next: 'The next small wins', contact: 'Let’s build what’s next.', contactBody: 'Small questions and new possibilities are always welcome.', sound: 'Sound on', mute: 'Sound off', pause: 'Pause', play: 'Play', film: 'TWMS brand film', skip: 'Skip to content' },
 ja: { intro: '小さな始まりから、大きな可能性へ。', body: 'AIとともにつくり、繰り返しを自動化する。小さなアイデアを、実際に動くサービスへ。それがTWMSのモメンタムです。', explore: '私たちのサービス', scroll: 'スクロールしてもっと見る', approach: '小さな勝利をつくる方法', products: 'アイデアを、日常に。', productBody: '繰り返す作業を減らし、大切なことに集中するために。', next: '次の小さな勝利', contact: '次のアイデアを、ともに。', contactBody: '小さな質問も、新しい可能性も歓迎します。', sound: '音声オン', mute: '音声オフ', pause: '一時停止', play: '再生', film: 'TWMSブランドフィルム', skip: '本文へスキップ' }
}[lang];
const principles = [
 { no: '01', word: 'COLLABORATE.', ...t.features.ai },
 { no: '02', word: 'AUTOMATE.', ...t.features.automation },
 { no: '03', word: 'BUILD MOMENTUM.', ...t.features.smallWins },
];
const serviceCopy = {
 ko: { navigation: '서비스 바로가기', inquiry: '프로젝트 문의', focus: 'FOCUS', descriptions: ['에러페어와 항공 특가의 발견. 생각만 하던 여행을 더 가까이.', '흩어진 경험과 리뷰를 모아, 선택에 도움이 되는 정보를 살펴봅니다.', '여러 선택지 사이에서 나의 취향과 기준에 맞는 발견을 찾아갑니다.', '지식과 도구를 연결해, 일상의 작업을 함께하는 AI 어시스턴트.', '여러 AI 에이전트와 도구의 흐름을 조율하고, 아이디어를 실행으로 이어갑니다.'], features: [['에러페어 발견', '항공 특가', '여행 뉴스레터'], ['리뷰 탐색', '경험 공유', '선택의 근거'], ['취향 탐색', '선택지 비교', '나에게 맞는 발견'], ['AI 어시스턴트', '지식 연결', '작업 지원'], ['에이전트 조율', '도구 연결', '워크플로 설계']] },
 en: { navigation: 'Explore the services', inquiry: 'Ask about this project', focus: 'FOCUS', descriptions: ['Turn travel possibilities into a plan. Give your next journey a clearer direction.', 'Bring experiences and reviews together to inform your next choice.', 'Discover options that fit your preferences and what matters to you.', 'An AI assistant connecting knowledge and tools to support everyday work.', 'Coordinate AI agents and tools, turning connected workflows into action.'], features: [['Travel planning', 'Itineraries', 'Explore journeys'], ['Explore reviews', 'Shared experiences', 'Informed choices'], ['Explore preferences', 'Compare options', 'Find your fit'], ['AI assistant', 'Connected knowledge', 'Task support'], ['Agent coordination', 'Connected tools', 'Workflow design']] },
 ja: { navigation: 'サービス一覧', inquiry: 'プロジェクトについて問い合わせ', focus: 'FOCUS', descriptions: ['旅の可能性を、一つの計画に。次の旅をもっと描きやすく。', '体験とレビューを集め、次の選択に役立つ情報を探します。', '自分の好みや大切にする基準に合う選択肢を見つけます。', '知識とツールをつなぎ、日々の作業を支えるAIアシスタント。', '複数のAIエージェントとツールを連携させ、アイデアを実行へ。'], features: [['旅行計画', '旅程づくり', '旅の探索'], ['レビュー探索', '体験の共有', '選択の根拠'], ['好みの探索', '選択肢の比較', '自分に合う発見'], ['AIアシスタント', '知識の連携', '作業サポート'], ['エージェント連携', 'ツール連携', 'ワークフロー設計']] },
}[lang];
const projects = [
 { id: 'tripplan', name: 'Tripplan', no: '02', category: 'TRAVEL / PLANNING', slogan: 'A LITTLE PLAN. A BIG JOURNEY.', theme: 'electric-blue', art: 'travel', reverse: true },
 { id: 'jarvis', name: 'Jarvis', no: '03', category: 'AI / EVERYDAY ASSISTANT', slogan: 'A LITTLE HELP. MORE POSSIBILITY.', theme: 'forest', art: 'assistant', reverse: false },
 { id: 'orch-ai', name: 'Orch AI', no: '04', category: 'AI / ORCHESTRATION', slogan: 'AI AGENTS. IN SYNC.', theme: 'pink', art: 'agents', reverse: true },
 { id: 'twms-studio', name: 'TWMS Studio', no: '05', category: 'STUDIO / CREATIVE EXPLORATION', slogan: 'SMALL IDEAS. MADE REAL.', theme: 'butter', art: 'studio', reverse: false },
];
const studioCopy = {
 ko: { description: '새로운 아이디어를 실험하고, 작은 영감을 구체적인 결과물로 만들어가는 TWMS의 크리에이티브 스튜디오.', features: ['아이디어 탐색', '크리에이티브 실험', '함께 만들기'] },
 en: { description: 'A creative studio for exploring ideas and turning small sparks of inspiration into tangible work.', features: ['Explore ideas', 'Creative experiments', 'Create together'] },
 ja: { description: '新しいアイデアを試し、小さなひらめきを具体的な形にするTWMSのクリエイティブスタジオ。', features: ['アイデア探索', '創造的な実験', 'ともにつくる'] },
}[lang];
const projectDescriptions = [...serviceCopy.descriptions.filter((_, index) => index !== 1 && index !== 2), studioCopy.description];
const projectFeatures = [...serviceCopy.features.filter((_, index) => index !== 1 && index !== 2), studioCopy.features];
const projectUrls: Record<string, string> = { tripplan: 'https://tripplan.twms.ai/' };
const visitService = { ko: '서비스 바로가기', en: 'Visit service', ja: 'サービスを開く' }[lang];
const previewLabel = { ko: '화면 미리보기', en: 'Preview screens', ja: '画面プレビュー' }[lang];
const previewServices = ['jarvis', 'orch-ai', 'twms-studio'] as const;
const hasPreview = (id: string) => previewServices.some(service => service === id);
const filmMessages = {
 ko: { audio: '소리를 시작하지 못했습니다. 소리 버튼을 다시 눌러주세요.', unavailable: '모션을 불러오지 못했습니다. 페이지를 새로고침해 주세요.' },
 en: { audio: 'Audio could not start. Tap the sound button to retry.', unavailable: 'The motion player could not load. Please refresh the page.' },
 ja: { audio: '音声を開始できません。音声ボタンで再試行してください。', unavailable: 'モーションを読み込めませんでした。ページを再読み込みしてください。' },
}[lang];
---

<a class="skip-link" href="#about">{c.skip}</a>
<header class="site-header" data-header>
 <div class="header-inner">
  <a class="wordmark" href={getLocalizedPath('/', lang)} aria-label="TWMS — Tiny Wins Make Success">TWMS<span class="brand-dot"></span></a>
  <nav aria-label={t.nav.about}>
   <a href="#about">{t.nav.about}</a><a href="#features">{t.nav.features}</a><a href="#services">{t.nav.services}</a>
   <a href={withHomepageUtm('https://blog.twms.ai/', 'header', lang)} target="_blank" rel="noopener noreferrer" data-analytics-event="blog_click" data-analytics-location="header">{t.nav.blog} ↗</a>
  </nav>
  <details class="language-picker">
   <summary aria-label="Select language"><span aria-hidden="true">◎</span> {lang.toUpperCase()} <span aria-hidden="true">⌄</span></summary>
   <div class="language-menu">{Object.entries(languages).map(([code, label]) => <a href={getLocalizedPath('/', code as Lang)} aria-current={code === lang ? 'page' : undefined} data-analytics-event="language_change" data-analytics-label={code}>{label}<span>{code === lang ? '✓' : ''}</span></a>)}</div>
  </details>
 </div>
</header>
<main>
 <section class="film-section" aria-label={c.film}>
  <div class="film-frame">
   <iframe id="brand-film" class="motion-frame" src={`/motion/twms-momentum.html?embedded=1&lang=${lang}`} title={c.film} allow="autoplay" loading="eager"></iframe>
   <div class="film-controls">
    <span class="film-caption"><span class="status-dot"></span> MOMENTUM / 00:19.5</span>
    <div class="film-buttons">
     <button type="button" class="sound-button" data-sound data-on={c.sound} data-off={c.mute} aria-label={c.sound} title={c.sound} aria-pressed="false" disabled>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
       <path d="M11 5 6 9H3v6h3l5 4V5Z" />
       <g class="sound-muted"><path d="m16 9 6 6m0-6-6 6" /></g>
       <g class="sound-audible"><path d="M15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14" /></g>
      </svg>
     </button>
     <button type="button" data-play data-play-label={c.play} data-pause-label={c.pause} aria-label={c.pause} disabled><span data-play-icon aria-hidden="true">Ⅱ</span></button>
    </div>
   </div>
   <p class="film-status" data-film-status data-audio-error={filmMessages.audio} data-unavailable={filmMessages.unavailable} role="status" aria-live="polite" hidden></p>
   <div class="film-progress" aria-hidden="true"><span data-progress></span></div>
  </div>
  <div class="film-bottom"><span>Tiny Wins. Make Success.</span><a href="#about">{c.scroll}<span aria-hidden="true">↓</span></a></div>
 </section>
 <section class="intro section-shell" id="about">
  <div class="eyebrow"><span class="section-number">01 / ABOUT US</span><span class="small-label">A LITTLE EVERY DAY.</span></div>
  <div class="intro-grid">
   <h1>Tiny Wins.<br />Make <span class="serif-word">Success.</span><span class="lime-period">↗</span></h1>
   <div class="intro-copy"><h2>{c.intro}</h2><p>{c.body}</p><a class="text-link" href="#services">{c.explore}<span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="manifesto-strip"><span>TINY WINS</span><span aria-hidden="true">✳</span><span>MAKE SUCCESS</span><span aria-hidden="true">✳</span><span>ONE STEP AT A TIME</span></div>
 </section>
 <section class="approach section-shell" id="features">
  <div class="eyebrow"><span class="section-number">02 / OUR APPROACH</span></div>
  <div class="section-heading"><h2>{c.approach}</h2><span class="orbit-symbol" aria-hidden="true">✳</span></div>
  <div class="principle-grid">{principles.map(item => <article class="principle"><span class="principle-number">{item.no}</span><h3>{item.word}</h3><h4>{item.title}</h4><p>{item.description}</p></article>)}</div>
 </section>
 <section class="products section-shell" id="services">
  <div class="eyebrow"><span class="section-number">03 / SELECTED WORK</span><span class="small-label">ALWAYS IN PROGRESS.</span></div>
  <div class="section-heading"><h2>{c.products}</h2><p>{c.productBody}</p></div>
  <nav class="service-jumps" aria-label={serviceCopy.navigation}>
   <a href="#autogram"><span>01</span>Autogram<span aria-hidden="true">↓</span></a>
   {projects.map(project => <a href={`#${project.id}`}><span>{project.no}</span>{project.name}<span aria-hidden="true">↓</span></a>)}
  </nav>
  <article class="featured-product" id="autogram">
   <div class="product-art" aria-label="Autogram — Instagram automation">
    <span class="art-label">LESS REPETITION. MORE CONNECTION.</span>
    <div class="automation-diagram">
     <div class="message-card"><span class="message-icon">↳</span><span>COMMENT<span class="message-line"></span><span class="message-line short"></span></span><span class="message-check">✓</span></div>
     <div class="connection-path"><span></span><span>✳</span><span></span></div>
     <div class="message-card result"><span class="message-icon">↗</span><span>DIRECT MESSAGE<span class="message-line"></span><span class="message-line short"></span></span><span class="message-check">✓</span></div>
    </div>
    <span class="art-wordmark">Autogram<span>↗</span></span>
   </div>
   <div class="product-copy"><div class="product-meta"><span>01 / SOCIAL AUTOMATION</span><span class="badge"><span class="status-dot"></span>{t.services.badges.beta}</span></div><h3>{t.services.autogram.title}</h3><p>{t.services.autogram.description}</p><a class="button-primary" href={withHomepageUtm('https://autogram.twms.ai/', 'autogram_card', lang)} target="_blank" rel="noopener noreferrer" data-analytics-event="autogram_cta_click" data-analytics-location="services">{visitService}<span aria-hidden="true">↗</span></a><a class="instagram-link" href="https://www.instagram.com/autogram.official/" target="_blank" rel="noopener noreferrer" aria-label="Autogram Instagram — @autogram.official" title="@autogram.official">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
   </a></div>
  </article>
  {projects.map((project, index) => <article class:list={['featured-product', 'project-feature', project.theme, { 'is-reversed': project.reverse }]} id={project.id}>
   <div class="product-art">
    <span class="art-label">{project.slogan}</span>
    {project.art === 'travel' && <div class="travel-art" aria-hidden="true">
     <div class="map-grid"></div><svg viewBox="0 0 360 200" fill="none"><path d="M45 145C25 25 160 25 170 90S315 205 315 45" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6"/><circle cx="45" cy="145" r="9" fill="currentColor"/><circle cx="170" cy="90" r="7" fill="currentColor"/><circle cx="315" cy="45" r="9" fill="currentColor"/></svg>
     <span class="map-tag origin">01 / START HERE</span><span class="map-tag destination">03 / SOMEWHERE NEW</span><div class="itinerary-card"><span>YOUR NEXT CHAPTER</span><strong>A way forward. ↗</strong><div><i></i><i></i><i></i></div></div>
    </div>}
    {project.art === 'reviews' && <div class="review-art" aria-hidden="true"><div class="review-sheet"><span>EXPERIENCES</span><strong>Read the stories.</strong><div class="review-stars">★★★★★</div><div class="review-line"></div><div class="review-line short"></div></div><div class="review-sheet second"><span>INSIGHTS</span><strong>Choose better.</strong><div class="review-stars">★★★★☆</div><div class="review-line"></div><div class="review-line short"></div></div></div>}
    {project.art === 'studio' && <div class="studio-art" aria-hidden="true"><div class="studio-canvas"><div class="studio-toolbar"><span>● ● ●</span><span>TWMS / STUDIO</span></div><div class="studio-composition"><span class="studio-square"></span><span class="studio-circle"></span><span class="studio-spark">✳</span><strong>Make<br /><em>something.</em></strong></div><div class="studio-caption"><span>IDEA → EXPERIMENT → CREATE</span><span>↗</span></div></div></div>}
    {project.art === 'assistant' && <div class="jarvis-portrait" aria-hidden="true">
     <svg viewBox="0 0 400 280" fill="none"><circle cx="200" cy="125" r="100" stroke="#b79af4" stroke-opacity=".18"/><circle cx="200" cy="125" r="79" stroke="#b79af4" stroke-opacity=".35"/><path d="M110 125A90 90 0 0 1 200 35M290 125A90 90 0 0 1 200 215" stroke="#d1ff43" stroke-width="3" stroke-linecap="round"/><circle cx="200" cy="125" r="58" fill="#b79af4"/><text x="200" y="153" text-anchor="middle" fill="#102b1b" font-family="Inter, Arial, sans-serif" font-size="82" font-weight="800">J</text><path d="M95 251H119M129 238V264M140 245V257M151 229V273M162 238V264M173 219V279M184 231V267M195 238V264M206 223V279M217 235V267M228 242V260M239 233V269M250 244V258M261 237V265M273 251H305" stroke="#d1ff43" stroke-width="5" stroke-linecap="round"/></svg>
     <span class="jarvis-bubble ask-bubble">HELLO, JARVIS <span>↗</span></span><span class="jarvis-bubble reply-bubble"><i></i><i></i><i></i></span><span class="jarvis-listening">VOICE / MEMORY / YOUR DAY</span>
    </div>}
    {project.art === 'agents' && <div class="orch-network" aria-hidden="true">
     <svg viewBox="0 0 400 280" fill="none"><path d="M70 70H184V130H270M70 210H184V130M270 130H345V210H184" stroke="#426b39" stroke-width="2"/><path d="M184 130H270M345 210H184" stroke="#426b39" stroke-width="2" stroke-dasharray="5 6"/><circle cx="184" cy="130" r="8" fill="#102b1b"/><circle cx="345" cy="210" r="5" fill="#426b39"/><path d="m248 125 7 5-7 5m-28 70-7 5 7 5" stroke="#426b39" stroke-width="2"/></svg>
     <span class="orch-node source-node"><small>01 / INPUT</small><strong>◇ Knowledge</strong></span><span class="orch-node task-node"><small>02 / PLAN</small><strong>≡ Tasks</strong></span><span class="orch-node execute-node"><small>03 / EXECUTE</small><strong>↗ Agents</strong><span>BUILD → VERIFY</span></span><span class="orch-loop">↻ FEEDBACK LOOP</span><span class="orch-network-label">CONNECTED. COORDINATED.</span>
    </div>}
    <span class="art-wordmark">{project.name}<span>↗</span></span>
   </div>
   <div class="product-copy"><div class="product-meta"><span>{project.no} / {project.category}</span></div><h3>{project.name}</h3><p>{projectDescriptions[index]}</p><ul class="project-focus" aria-label={serviceCopy.focus}>{projectFeatures[index].map(feature => <li>{feature}</li>)}</ul><div class="project-actions">
    {hasPreview(project.id) && <button type="button" class="button-primary" data-open-preview={`preview-${project.id}`} aria-haspopup="dialog" aria-controls={`preview-${project.id}`} data-analytics-event="service_preview_open" data-analytics-location={project.id}>{previewLabel}<span aria-hidden="true">⊞</span></button>}
    {projectUrls[project.id] ? <a class="button-primary" href={withHomepageUtm(projectUrls[project.id], `${project.id}_card`, lang)} target="_blank" rel="noopener noreferrer" data-analytics-event="service_click" data-analytics-location={project.id}>{visitService}<span aria-hidden="true">↗</span></a> : <button type="button" class:list={['button-primary', { 'button-outline': hasPreview(project.id) }]} data-open-contact data-contact-subject={project.name} data-analytics-event="contact_open" data-analytics-location={project.id}>{serviceCopy.inquiry}<span aria-hidden="true">↗</span></button>}
   </div>
   {project.id === 'twms-studio' && <a class="instagram-link" href="https://www.instagram.com/nori_hini/" target="_blank" rel="noopener noreferrer" aria-label="TWMS Studio Instagram — @nori_hini" title="@nori_hini" data-analytics-event="instagram_click" data-analytics-location="twms-studio">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
   </a>}
   </div>
  </article>)}
 </section>
 <section class="contact section-shell"><div class="contact-top"><span class="section-number">KEEP THE MOMENTUM GOING.</span><span aria-hidden="true">↗</span></div><h2>{c.contact}</h2><p>{c.contactBody}</p><button type="button" class="contact-link" data-open-contact data-analytics-event="contact_open" data-analytics-location="contact">info@twms.ai<span aria-hidden="true">↗</span></button></section>
</main>
<footer class="site-footer section-shell"><a class="wordmark" href={getLocalizedPath('/', lang)}>TWMS<span class="brand-dot"></span></a><p>{t.footer.copyright.replace('{year}', String(new Date().getFullYear()))}</p><a href={withHomepageUtm('https://blog.twms.ai/', 'footer', lang)} target="_blank" rel="noopener noreferrer" data-analytics-event="blog_click" data-analytics-location="footer">{t.nav.blog} ↗</a><a href="#top" aria-label="Back to top">↑</a></footer>
<ContactForm lang={lang} />
{previewServices.map(service => <ServicePreview lang={lang} service={service} />)}

<script>
 import { bindMotionControls } from '../utils/motion-controls.js';
 const header = document.querySelector<HTMLElement>('[data-header]');
 const updateHeader = () => header?.classList.toggle('is-floating', window.scrollY > 60);
 window.addEventListener('scroll', updateHeader, { passive: true });
 updateHeader();
 const language = document.querySelector<HTMLDetailsElement>('.language-picker');
 document.addEventListener('click', event => { if (event.target instanceof Node && !language?.contains(event.target)) language?.removeAttribute('open'); });
 document.addEventListener('keydown', event => { if (event.key === 'Escape') language?.removeAttribute('open'); });
 const film = document.querySelector<HTMLIFrameElement>('#brand-film');
 const sound = document.querySelector<HTMLButtonElement>('[data-sound]');
 const play = document.querySelector<HTMLButtonElement>('[data-play]');
 const progress = document.querySelector<HTMLElement>('[data-progress]');
 if (film && sound && play) {
  bindMotionControls({ film, sound, play, progress, status: document.querySelector<HTMLElement>('[data-film-status]') });
 }
 document.addEventListener('click', event => {
  if (!(event.target instanceof Element)) return;
  const target = event.target.closest<HTMLElement>('[data-analytics-event]');
  const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
  if (!target || !gtag) return;
  gtag('event', target.dataset.analyticsEvent, { event_label: target.dataset.analyticsLabel || target.textContent?.trim(), placement: target.dataset.analyticsLocation, page_language: document.documentElement.lang, link_url: target instanceof HTMLAnchorElement ? target.href : undefined });
 });
</script>
