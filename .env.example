# Public key for the Turnstile widget; available in the compiled HTML.
PUBLIC_TURNSTILE_SITE_KEY=
# Server-only variables. Register these in Vercel, never with PUBLIC_ prefixes.
TURNSTILE_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Use an SES-verified sender address/domain in the region above.
SES_FROM_EMAIL=info@twms.ai
CONTACT_TO_EMAIL=info@twms.ai
CONTACT_ALLOWED_ORIGINS=https://www.twms.ai,https://twms.ai
